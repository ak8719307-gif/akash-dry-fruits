# Copy this file to ".env" and fill in real values. NEVER commit the real .env file.

PORT=3000

# Long random strings - change these before going live
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_secret

# Default admin account (created automatically the first time the server starts
# if no admin exists yet). Change the password immediately after first login.
DEFAULT_ADMIN_EMAIL=admin@akashdryfruits.com
DEFAULT_ADMIN_PASSWORD=ChangeMe@123

# Business contact info shown on the site
BUSINESS_WHATSAPP=919999999999
BUSINESS_PHONE=+91-9999999999
BUSINESS_EMAIL=support@akashdryfruits.com
BUSINESS_ADDRESS=Akash Dry Fruits, Chennai, Tamil Nadu, India

# Optional: SMTP for admin email notifications on new orders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# Optional: WhatsApp Cloud API (Meta) credentials for server-side admin notifications
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
